# Copy to .env (agent) and web/.env.local (frontend). Never commit real values.

# LiveKit Cloud project (server-side only). From `lk cloud auth` or cloud.livekit.io.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI key for the plugin (used when REALTIME_PROVIDERS includes openai). Server-side only.
OPENAI_API_KEY=

# Ordered realtime providers. openai uses OPENAI_API_KEY; inference uses LiveKit Inference.
REALTIME_PROVIDERS=openai,inference
# Unprefixed id; inference adds the openai/ prefix.
REALTIME_MODEL=gpt-realtime-2.1

# Agent name used for explicit dispatch. Must match the agent's registration.
AGENT_NAME=chalk-talk-agent

# Non-secret values the browser may read. Never put a key behind NEXT_PUBLIC_.
NEXT_PUBLIC_APP_URL=http://localhost:3000
