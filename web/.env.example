# LiveKit credentials for POST /api/token (server-side only). Required.
# Copy the private repo-root .env into web/.env.local. Never commit real values.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent dispatch name. Must match the agent's @server.rtc_session(agent_name=...).
AGENT_NAME=chalk-talk-agent
